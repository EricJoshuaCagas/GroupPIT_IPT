# Backend Configuration

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# For SQLite (local development):
# Leave below PostgreSQL variables empty or commented

# For PostgreSQL (Render or other services):
# Uncomment and set these variables with your actual credentials
# DATABASE_URL=postgresql://username:password@host:port/dbname
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_HOST=your_database_host
# DB_PORT=5432

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173
